# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (developer.paypal.com → Apps & Credentials; sandbox first, then live)
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase operator credentials (DB connection + management token) live in
# a separate gitignored .env at the project root — see docs/db.md.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WRITING_PRICE_ID=
STRIPE_UOE_PRICE_ID=
STRIPE_LISTENING_PRICE_ID=

# Google Sheets (base64-encoded service account JSON)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email
RESEND_API_KEY=

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
